{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook SessionStart",
                        "timeout": 10,
                        "statusMessage": "Starting workflow visualizer"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook UserPromptSubmit",
                        "timeout": 10,
                        "statusMessage": "Visualizing user prompt"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook PreToolUse",
                        "timeout": 10,
                        "statusMessage": "Visualizing tool call"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook PostToolUse",
                        "timeout": 10,
                        "statusMessage": "Visualizing tool result"
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook SubagentStart",
                        "timeout": 10,
                        "statusMessage": "Visualizing sub-agent start"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook SubagentStop",
                        "timeout": 10,
                        "statusMessage": "Visualizing sub-agent stop"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run hook Stop",
                        "timeout": 10,
                        "statusMessage": "Visualizing final output"
                    }
                ]
            }
        ]
    }
}
